<view>
  <view>
    <image class="cardimage" mode="widthFix" src="https://7973-ysj-2gufe9z9f9118b4f-1326910532.tcb.qcloud.la/AR-YSJ/UI/top.png?sign=5b9b038c6ea3c08ab22c63a1502d8978&amp;t=1717381436" />
  </view>
  <view wx:if="{{showCoarPoc}}" class="harmony-poc" bindtap="openCoarPoc">
    <view class="harmony-poc-title">鸿蒙 AR 方案测试</view>
    <view class="harmony-poc-desc">验证图片识别、摄像头与纯血鸿蒙兼容性</view>
  </view>
  <view wx:if="{{showCoarPoc}}" class="harmony-poc webar-poc" bindtap="openCoarWebAr">
    <view class="harmony-poc-title">鸿蒙 WebAR 兼容测试</view>
    <view class="harmony-poc-desc">体验本尊墨玉版，由共创 AR 插件引导进入 WebAR</view>
  </view>
  <view wx:if="{{showSelfHostedPoc}}" class="harmony-poc" bindtap="openSelfHostedAr">
    <view class="harmony-poc-title">小程序内 AR 能力验证</view>
    <view class="harmony-poc-desc">验证鸿蒙小程序内的摄像头和自有域名 AR</view>
  </view>
  <view wx:if="{{showNativePoc}}" class="harmony-poc" bindtap="openNativeProbe">
    <view class="harmony-poc-title">鸿蒙原生相机检测</view>
    <view class="harmony-poc-desc">无需服务器，检测实时画面帧和图形能力</view>
  </view>
  <view wx:if="{{showNativePoc}}" class="harmony-poc" bindtap="openNativeTracker">
    <view class="harmony-poc-title">本尊原生图片追踪</view>
    <view class="harmony-poc-desc">验证卡片定位和追踪边框，无需服务器</view>
  </view>
