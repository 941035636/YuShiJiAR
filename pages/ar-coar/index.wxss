page,
.page {
  min-height: 100%;
  background: #07111f;
}

.ar-stage,
.coar-viewer {
  display: block;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #000000;
}

.page {
  padding: 48rpx 36rpx;
  box-sizing: border-box;
}

.card {
  padding: 48rpx 36rpx;
  color: #d8eaff;
  background: #102238;
  border: 1rpx solid rgba(116, 198, 255, 0.35);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 64rpx rgba(0, 0, 0, 0.3);
}

.title {
  margin-bottom: 24rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
}

.description,
.notice {
  font-size: 28rpx;
  line-height: 1.7;
}

.primary-button,
.secondary-button {
  margin-top: 30rpx;
  border-radius: 14rpx;
}

.primary-button {
  color: #06111e;
  background: #78caff;
}

.secondary-button {
  color: #d8eaff;
  background: #1b3858;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.meta {
  margin-top: 36rpx;
  color: #8fc6ee;
  font-size: 26rpx;
}

.notice {
  margin-top: 26rpx;
  padding: 24rpx;
  color: #ffd6a0;
  background: rgba(115, 68, 18, 0.28);
  border-radius: 12rpx;
}
