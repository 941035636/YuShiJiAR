<view wx:if="{{arStarted && sceneId}}" class="ar-stage">
  <coar-scene-component
    class="coar-viewer"
    sceneId="{{sceneId}}"
    showFeedback="{{true}}"
    screenIndicate="{{screenIndicate}}"
    toolbar="{{toolbar}}"
  ></coar-scene-component>
</view>

<view wx:else class="page">
  <view class="card">
    <view class="title">{{isBusiness ? sceneTitle + (isWebArFallback ? " WebAR" : " AR") : (isWebArFallback ? sceneTitle : "鸿蒙 AR 图片识别测试")}}</view>
    <view wx:if="{{isWebArFallback && isBusiness}}" class="description">复制体验链接，在手机浏览器中粘贴打开；也可以发送到微信聊天后点击。请在另一台设备上显示识别图，允许摄像头后对准图片。</view>
    <view wx:elif="{{isWebArFallback}}" class="description">通过共创 AR 插件查看网页体验引导。</view>
    <view wx:else class="description">先在另一台设备或电脑上打开识别图，再点击开始测试并将摄像头对准识别图。</view>

    <view wx:if="{{isBusiness}}">
      <view wx:if="{{availableVariants.length === 1}}" class="meta">{{availableVariants[0].label}}</view>
      <block wx:if="{{availableVariants.length > 1}}">
        <button wx:for="{{availableVariants}}" wx:key="key" data-variant="{{item.key}}" bindtap="chooseVariant" type="{{variant === item.key ? 'primary' : 'default'}}">{{item.label}}</button>
      </block>
    </view>
    <button wx:if="{{isBusiness && isWebArFallback}}" class="primary-button" bindtap="copyWebArLink">复制体验链接</button>
    <button class="{{isBusiness && isWebArFallback ? 'secondary-button' : 'primary-button'}}" bindtap="startImageAr">{{isWebArFallback ? "查看插件体验引导" : (isBusiness ? "开始 AR" : "开始图片 AR 测试")}}</button>
    <button wx:if="{{markerUrl}}" class="secondary-button" bindtap="previewMarker">查看识别图</button>

    <view wx:if="{{!isWebArFallback}}" class="meta">{{sceneTitle}}</view>
    <view wx:if="{{!isBusiness}}" class="notice">{{isWebArFallback ? "该入口使用共创 AR 官方手掌示例，仅验证鸿蒙 WebAR 兜底流程，不代表遇石记业务场景已经迁移。" : "当前页面仅用于技术兼容性验证。"}}</view>
  </view>
</view>
