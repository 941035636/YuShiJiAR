page,
.page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #060b13;
}

.kivicube-scene {
  display: block;
  width: 100vw;
  height: 100vh;
}

.status-bar {
  position: fixed;
  top: 24rpx;
  left: 50%;
  z-index: 20;
  display: flex;
  align-items: center;
  max-width: 660rpx;
  min-height: 64rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.4;
  background: rgba(5, 12, 22, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 34rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  pointer-events: none;
}

.status-tracked {
  background: rgba(11, 104, 71, 0.82);
}

.status-error {
  background: rgba(150, 37, 45, 0.88);
}

.progress {
  margin-left: 16rpx;
  color: #aee5ff;
}

.setup-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 48rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 30%, #18314f 0, #060b13 68%);
}

.setup-card {
  width: 100%;
  padding: 52rpx 42rpx;
  color: #dcecff;
  background: rgba(17, 32, 51, 0.96);
  border: 1rpx solid rgba(112, 191, 255, 0.35);
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 22rpx 80rpx rgba(0, 0, 0, 0.35);
}

.setup-title {
  margin-bottom: 28rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
}

.setup-text {
  margin-bottom: 34rpx;
  color: #b9cde3;
  font-size: 28rpx;
  line-height: 1.7;
}

.setup-meta {
  margin-top: 12rpx;
  color: #89bde9;
  font-size: 26rpx;
}

.back-button {
  margin-top: 44rpx;
  color: #06111e;
  background: #79c9ff;
  border-radius: 12rpx;
}

.back-button::after {
  border: 0;
}
