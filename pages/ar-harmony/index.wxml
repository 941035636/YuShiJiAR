<view class="page">
  <kivicube-scene
    wx:if="{{configured}}"
    class="kivicube-scene"
    scene-id="{{sceneId}}"
    camera-position="back"
    resolution="medium"
    flash="off"
    touchable="{{true}}"
    bindready="handleReady"
    binderror="handleError"
    binddownloadAssetStart="handleDownloadStart"
    binddownloadAssetProgress="handleDownloadProgress"
    binddownloadAssetEnd="handleDownloadEnd"
    bindloadSceneStart="handleLoadStart"
    bindloadSceneEnd="handleLoadEnd"
    bindsceneStart="handleSceneStart"
    bindtracked="handleTracked"
    bindlostTrack="handleLostTrack"
  />

  <view wx:if="{{configured}}" class="status-bar status-{{status}}">
    <text>{{statusText}}</text>
    <text wx:if="{{progressText}}" class="progress">{{progressText}}</text>
  </view>

  <view wx:if="{{!configured}}" class="setup-panel">
    <view class="setup-card">
      <view class="setup-title">鸿蒙 AR 场景尚未配置</view>
      <view class="setup-text">{{setupMessage}}</view>
      <view class="setup-meta">场景：{{sceneTitle}}</view>
      <view class="setup-meta">识别图：{{marker}}</view>
      <button class="back-button" bindtap="goBack">返回选择页</button>
    </view>
  </view>
</view>
