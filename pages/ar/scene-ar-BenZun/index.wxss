body{background-color:#000}
.mask_bg,body{height:100%;width:100%}
.mask_bg{background:rgba(0,0,0,.3);left:0;position:absolute;top:0;z-index:10}
.mask_Img{height:100%;width:100%}
.mask_Box{position:relative;width:100%}
.rote{height:100%;left:0;position:absolute;top:0;width:100%}
.rote wx-image{-webkit-animation:rotate_music 5s linear infinite;animation:rotate_music 5s linear infinite;-webkit-transform-origin:50% 50%;transform-origin:50% 50%;width:95%}
@-webkit-keyframes rotate_music{0%{-webkit-transform:rotate(0deg);transform:rotate(0deg)}
50%{-webkit-transform:rotate(180deg);transform:rotate(180deg)}
100%{-webkit-transform:rotate(1turn);transform:rotate(1turn)}
}@keyframes rotate_music{0%{-webkit-transform:rotate(0deg);transform:rotate(0deg)}
50%{-webkit-transform:rotate(180deg);transform:rotate(180deg)}
100%{-webkit-transform:rotate(1turn);transform:rotate(1turn)}
}.Detecting{border-radius:100%;height:100%;left:0;overflow:hidden;position:absolute;top:0;width:100%}
.Detecting wx-image{-webkit-animation:d1 4s linear infinite;animation:d1 4s linear infinite}
@-webkit-keyframes d1{0%,100%{-webkit-transform:translateY(0);transform:translateY(0)}
50%{-webkit-transform:translateY(65vw);transform:translateY(65vw)}
}@keyframes d1{0%,100%{-webkit-transform:translateY(0);transform:translateY(0)}
50%{-webkit-transform:translateY(65vw);transform:translateY(65vw)}
}.ar3d{display:none;height:100%;left:0;position:absolute;top:0;width:100%;z-index:10}
.ar3d_box{height:90%;-webkit-perspective:1px;perspective:1px;-webkit-perspective-origin:50%;perspective-origin:50%;width:100%}
.ar3d_box wx-text{-webkit-animation:tz 5s linear infinite;animation:tz 5s linear infinite;color:#fff;font-size:1em}
@-webkit-keyframes tz{0%{-webkit-transform:translateZ(-3px);transform:translateZ(-3px)}
100%{-webkit-transform:translateZ(1px);transform:translateZ(1px)}
}@keyframes tz{0%{-webkit-transform:translateZ(-3px);transform:translateZ(-3px)}
100%{-webkit-transform:translateZ(1px);transform:translateZ(1px)}
}.loading{margin-top:20%;text-align:center;width:100%}
.loading .box{margin:0 auto;position:relative;width:60%}
.loading .bar{bottom:2%;height:40%;left:0;position:absolute;width:100%}
.loading .bar_loading{height:100%;width:100%}
.tips{margin-top:5%;text-align:center;width:100%}
.tips wx-image{width:70%}
.EndBox{height:90%;left:0;position:absolute;top:0;width:100%;z-index:2}
.EndBox .box{background:url(/images/bk.png-do-not-use-local-path-./pages/ar/scene-ar-BenZun/index.wxss&1&2362) 50% no-repeat;background-size:cover;height:100%;width:100%}
.faceMask{height:100%;top:0;z-index:999999}
.faceMask,.faceMask .bottom1{left:0;position:absolute;width:100%}
.faceMask .bottom1{bottom:0}
.faceMask .bottom1 wx-image{vertical-align:middle}
.faceMask .tips{bottom:5%;position:absolute;width:100%}
.faceMask .tips .box{margin:0 auto;position:relative;width:45%}
.faceMask .tips .close{position:absolute;right:-7%;top:-30%;width:20%}
