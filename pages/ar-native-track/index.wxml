<view class="page">
  <view class="stage" style="height:{{stageHeight}}px">
    <camera wx:if="{{running}}" class="camera-source" device-position="back" frame-size="medium" flash="off" bindinitdone="onCameraReady" binderror="onCameraError" bindstop="onCameraStopped" />
    <canvas id="frame-preview" type="webgl" class="ar-canvas" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;left:{{canvasLeft}}px;top:{{canvasTop}}px" />
    <cover-image class="frame-overlay" src="/images/bk.png" />
    <cover-view class="hud">
      <cover-view class="hud-title">{{sceneTitle}}</cover-view>
      <cover-view class="hud-status">{{experienceError ? experienceError : modelFailed ? '内容加载失败，请检查网络后重试' : !modelReady ? loadingText : !running ? '准备就绪，点击开始体验' : sceneVisible ? visibleText : promptText}}</cover-view>
      <cover-view wx:if="{{modelFailed}}" class="hud-action" bindtap="loadModel">重新加载</cover-view>
      <cover-view wx:if="{{effectsLoading}}" class="hud-status">正在加载场景效果…</cover-view>
      <cover-view wx:if="{{effectsFailed}}" class="hud-action" bindtap="loadEffects">部分场景效果未加载，点击重试</cover-view>
      <cover-view wx:if="{{audioFailed && soundEnabled}}" class="hud-status">声音暂时无法播放，可关闭后重新开启</cover-view>
    </cover-view>
    <cover-view class="toolbar">
      <cover-view class="toolbar-button toolbar-primary" bindtap="toggleRunning">{{running ? '暂停体验' : ready ? '开始体验' : '准备中'}}</cover-view>
      <cover-view class="toolbar-button" bindtap="toggleSound">{{soundEnabled ? '关闭声音' : '开启声音'}}</cover-view>
      <cover-view class="toolbar-button" bindtap="replayNarration">重播讲解</cover-view>
    </cover-view>
  </view>
</view>
